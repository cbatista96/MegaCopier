<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.OptionsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls"
    xmlns:local="using:MegaCopier.App.Views">

    <ScrollViewer>
        <StackPanel Spacing="8">
            <InfoBar x:Name="RunningInfo" x:Uid="Options_RunningInfo" Severity="Informational" IsClosable="False" IsOpen="False" />

            <Grid x:Name="OptionsGrid" ColumnSpacing="24" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Qué se copia -->
                <StackPanel x:Name="WhatColumn" Spacing="2">
                    <TextBlock x:Uid="Options_Transfer" Style="{StaticResource McStrong}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource McWarningBrush}" />
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE8A5;" FontSize="14" Foreground="{StaticResource McTextSecondaryBrush}" />
                        <TextBlock x:Uid="Options_FilesFolders" Style="{StaticResource McStrong}" />
                    </StackPanel>
                    <CheckBox x:Uid="Options_Data" IsChecked="True" IsEnabled="False" />
                    <CheckBox x:Name="TimestampsBox" x:Uid="Options_Timestamps" Click="Changed" />
                    <CheckBox x:Name="AttributesBox" x:Uid="Options_Attributes" Click="Changed" />
                    <CheckBox x:Name="StreamsBox" x:Uid="Options_Streams" Click="Changed" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE72E;" FontSize="14" Foreground="{StaticResource McWarningBrush}" />
                        <TextBlock x:Uid="Options_Security" Style="{StaticResource McStrong}" />
                    </StackPanel>
                    <CheckBox x:Name="AclBox" x:Uid="Options_Acl" Click="Changed" />
                    <CheckBox x:Name="OwnerBox" x:Uid="Options_Owner" Click="Changed" />
                    <CheckBox x:Name="AuditBox" x:Uid="Options_Audit" Click="Changed" />
                </StackPanel>

                <!-- Cómo se copia -->
                <StackPanel x:Name="HowColumn" Grid.Column="1" Spacing="8">
                    <TextBlock x:Uid="Options_TransferOptions" Style="{StaticResource McStrong}" />
                    <ComboBox x:Name="ModeBox" x:Uid="Options_Mode" HorizontalAlignment="Stretch" SelectionChanged="Changed">
                        <ComboBoxItem x:Uid="Mode_Copy" />
                        <ComboBoxItem x:Uid="Mode_Mirror" />
                        <ComboBoxItem x:Uid="Mode_Update" />
                        <ComboBoxItem x:Uid="Mode_Folders" />
                        <ComboBoxItem x:Uid="Mode_Organize" />
                    </ComboBox>
                    <InfoBar x:Name="MirrorInfo" x:Uid="Options_MirrorInfo" Severity="Warning" IsClosable="False" IsOpen="False" />
                    <CheckBox x:Name="DryRunBox" x:Uid="Options_DryRun" Click="Changed" />
                    <ComboBox x:Name="ConflictBox" HorizontalAlignment="Stretch" SelectionChanged="Changed">
                        <ComboBoxItem x:Uid="ConflictAsk" />
                        <ComboBoxItem x:Uid="ConflictReplace" />
                        <ComboBoxItem x:Uid="ConflictSkip" />
                        <ComboBoxItem x:Uid="ConflictNewer" />
                        <ComboBoxItem x:Uid="ConflictKeepBoth" />
                        <ComboBoxItem x:Uid="ConflictDifferentSize" />
                        <ComboBoxItem x:Uid="ConflictRenameExisting" />
                    </ComboBox>
                    <ComboBox x:Name="HashBox" HorizontalAlignment="Stretch" SelectionChanged="Changed" />
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="BufferBox" MinWidth="110" SelectionChanged="Changed">
                            <ComboBoxItem Content="1 MB" Tag="1" />
                            <ComboBoxItem Content="2 MB" Tag="2" />
                            <ComboBoxItem Content="4 MB" Tag="4" />
                            <ComboBoxItem Content="8 MB" Tag="8" />
                            <ComboBoxItem Content="16 MB" Tag="16" />
                        </ComboBox>
                        <TextBlock Grid.Column="1" x:Uid="Options_BufferSize" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <NumberBox x:Name="ThreadsBox" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" MinWidth="110" ValueChanged="ThreadsBox_ValueChanged" />
                        <TextBlock Grid.Column="1" x:Uid="Options_Threads" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <CheckBox x:Name="VerifyBox" x:Uid="Options_Verify" Click="Changed" />
                    <CheckBox x:Name="VerifySkippedBox" x:Uid="Options_VerifySkipped" Click="Changed" />
                    <CheckBox x:Name="CacheBox" x:Uid="Options_SystemCache" Click="Changed" />
                </StackPanel>

                <!-- Al terminar -->
                <StackPanel x:Name="FinishColumn" Grid.Column="2" Spacing="8">
                    <TextBlock x:Uid="Options_OnFinish" Style="{StaticResource McStrong}" />
                    <CheckBox x:Name="ChecksumBox" x:Uid="Options_SaveChecksum" Click="Changed" />
                    <CheckBox x:Name="ReportBox" x:Uid="Options_ExportReport" Click="Changed" />
                    <TextBlock x:Uid="Options_Scripts" Style="{StaticResource McSecondary}" />
                    <TextBox x:Name="ScriptsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="96" FontFamily="Consolas" LostFocus="Changed" />
                    <TextBlock x:Uid="Options_ScriptsHelp" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource McCard}" Margin="0,8,0,0">
                <local:RulesEditor x:Name="Rules" />
            </Border>

            <!-- Programar -->
            <Border Style="{StaticResource McCard}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE823;" FontSize="14" Accent="True" />
                        <TextBlock x:Uid="Schedule_Title" Style="{StaticResource McStrong}" />
                    </StackPanel>
                    <StackPanel x:Name="ScheduleRow" Orientation="Horizontal" Spacing="8">
                        <CalendarDatePicker x:Name="ScheduleDate" MinWidth="160" />
                        <TimePicker x:Name="ScheduleTime" ClockIdentifier="24HourClock" />
                        <Button Style="{StaticResource McAccentButton}" Click="Schedule_Click"><TextBlock x:Uid="Schedule_Set" /></Button>
                        <Button Style="{StaticResource McButton}" Click="StartNow_Click"><TextBlock x:Uid="Schedule_Now" /></Button>
                    </StackPanel>
                    <TextBlock x:Name="ScheduleInfo" Style="{StaticResource McSecondary}" />
                    <TextBlock x:Uid="Task_Header" Style="{StaticResource McSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel x:Name="TaskRow" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="TaskNameBox" x:Uid="Task_Name" MinWidth="200" />
                        <ComboBox x:Name="TaskFrequencyBox" MinWidth="150" SelectedIndex="1">
                            <ComboBoxItem x:Uid="Task_Once" />
                            <ComboBoxItem x:Uid="Task_Daily" />
                            <ComboBoxItem x:Uid="Task_Weekly" />
                            <ComboBoxItem x:Uid="Task_Monthly" />
                        </ComboBox>
                        <Button Style="{StaticResource McButton}" Click="SaveTask_Click"><TextBlock x:Uid="Task_Save" /></Button>
                    </StackPanel>
                    <TextBlock x:Name="TaskInfo" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource McButton}" Click="SaveDefault_Click">
                    <TextBlock x:Uid="Options_SaveDefault" />
                </Button>
                <Button Style="{StaticResource McButton}" Click="ResetDefault_Click">
                    <TextBlock x:Uid="Options_ResetDefault" />
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
