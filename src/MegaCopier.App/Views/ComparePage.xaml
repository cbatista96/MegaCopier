<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegaCopier.App.ViewModels">

    <Grid Padding="20,8,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título y volver -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon VerticalAlignment="Center" Glyph="&#xE8FD;" FontSize="20" Foreground="{StaticResource McAccentBrush}" />
                <TextBlock x:Uid="Compare_Title" Style="{StaticResource McTitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource McButton}" Click="Close_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock x:Uid="Page_Back" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Las dos carpetas -->
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Uid="Compare_Left" Style="{StaticResource McStrong}" VerticalAlignment="Center" />
            <TextBlock x:Name="LeftPath" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Style="{StaticResource McButton}" Click="PickLeft_Click"><TextBlock x:Uid="Compare_Change" /></Button>
            <TextBlock x:Uid="Compare_Right" Grid.Row="1" Style="{StaticResource McStrong}" VerticalAlignment="Center" />
            <TextBlock x:Name="RightPath" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="PickRightButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource McButton}" Click="PickRight_Click"><TextBlock x:Uid="Compare_Change" /></Button>
        </Grid>

        <!-- Sentido, comparar y resumen -->
        <StackPanel Grid.Row="2" Spacing="6">
            <StackPanel x:Name="Controls" Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="DirectionBox" MinWidth="240" SelectionChanged="Direction_SelectionChanged">
                    <ComboBoxItem x:Uid="Sync_TwoWay" />
                    <ComboBoxItem x:Uid="Sync_LeftToRight" />
                    <ComboBoxItem x:Uid="Sync_RightToLeft" />
                </ComboBox>
                <Button Style="{StaticResource McButton}" Click="Compare_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock x:Uid="Compare_Run" />
                    </StackPanel>
                </Button>
                <CheckBox x:Name="ShowEqualBox" x:Uid="Compare_ShowEqual" Click="ShowEqual_Click" MinWidth="0" />
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource McStrong}" TextWrapping="Wrap" />
            <TextBlock x:Uid="Compare_Info" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Las diferencias -->
        <ListView x:Name="List" Grid.Row="3" SelectionMode="None" BorderThickness="1" BorderBrush="{StaticResource McBorderBrush}" CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CompareRow">
                    <Grid ColumnSpacing="10" Padding="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind Include, Mode=TwoWay}" IsEnabled="{x:Bind CanInclude}" MinWidth="0" Padding="0" AutomationProperties.Name="{x:Bind Relative}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                <TextBlock Text="{x:Bind Relative}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Relative}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ReasonText}" Style="{StaticResource McSecondary}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind LeftText}" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <FontIcon Grid.Column="3" Glyph="{x:Bind ActionGlyph}" FontSize="16" Foreground="{StaticResource McAccentBrush}" ToolTipService.ToolTip="{x:Bind ActionText}" AutomationProperties.Name="{x:Bind ActionText}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind RightText}" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="Empty" Grid.Row="3" Style="{StaticResource McSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- Sincronizar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="SimulateButton" Style="{StaticResource McButton}" Click="Simulate_Click"><TextBlock x:Uid="Compare_Simulate" /></Button>
            <Button x:Name="SyncButton" Style="{StaticResource McAccentButton}" Click="Sync_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE895;" FontSize="12" />
                    <TextBlock x:Uid="Compare_Sync" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
