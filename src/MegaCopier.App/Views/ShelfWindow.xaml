<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MegaCopier.App.Views.ShelfWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls"
    xmlns:views="using:MegaCopier.App.Views">

    <Grid x:Name="Root" Background="{StaticResource McBackgroundBrush}" AllowDrop="True" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="36" Padding="12,0,48,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:McIcon Glyph="&#xE7B8;" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource McAccentBrush}" />
            <TextBlock x:Uid="Shelf_Title" Grid.Column="1" Style="{StaticResource McStrong}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Vacía: zona para soltar -->
        <Border x:Name="DropZone" Grid.Row="1" Margin="10,0,10,0" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource McBorderBrush}" Background="{StaticResource McSurfaceBrush}">
            <StackPanel Spacing="10" VerticalAlignment="Center" Padding="16">
                <c:McIcon Glyph="&#xE896;" FontSize="32" Foreground="{StaticResource McAccentBrush}" />
                <TextBlock x:Uid="Shelf_Empty" Style="{StaticResource McSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ListView x:Name="List" Grid.Row="1" Margin="6,0,6,0" SelectionMode="Extended" CanDragItems="True" DragItemsStarting="List_DragItemsStarting" Visibility="Collapsed">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:ShelfItem">
                    <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind Path}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:McIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource McBody}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                            <TextBlock Text="{x:Bind Folder}" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullFolder}" />
                        </StackPanel>
                        <Button x:Uid="Shelf_Remove" Grid.Column="2" Style="{StaticResource McToolButton}" Click="Remove_Click" Tag="{x:Bind Path}" AutomationProperties.Name="{x:Bind RemoveName}">
                            <c:McIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="Summary" Grid.Row="2" Margin="14,8,14,0" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="3" Padding="10" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyButton" Style="{StaticResource McAccentButton}" HorizontalAlignment="Stretch" Click="Copy_Click" IsEnabled="False">
                <TextBlock x:Uid="Shelf_CopyTo" TextTrimming="CharacterEllipsis" />
            </Button>
            <Button x:Name="MoveButton" Grid.Column="1" Style="{StaticResource McButton}" HorizontalAlignment="Stretch" Click="Move_Click" IsEnabled="False">
                <TextBlock x:Uid="Shelf_MoveTo" TextTrimming="CharacterEllipsis" />
            </Button>
            <Button x:Name="ClearButton" x:Uid="Shelf_Clear" Grid.Column="2" Style="{StaticResource McToolButton}" Click="Clear_Click" IsEnabled="False">
                <c:McIcon Glyph="&#xE74D;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</Window>
