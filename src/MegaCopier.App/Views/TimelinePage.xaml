<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls">

    <Grid Padding="20,8,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <c:BackButton Click="Close_Click" Margin="-8,0,0,0" />
                <c:McIcon VerticalAlignment="Center" Glyph="&#xE121;" FontSize="20" Accent="True" />
                <TextBlock x:Uid="Timeline_Title" Style="{StaticResource McTitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock x:Name="Summary" Style="{StaticResource McStrong}" TextWrapping="Wrap" />
            <TextBlock x:Uid="Timeline_Info" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Eje: de ahora a cuando termina todo -->
        <Grid x:Name="Axis" Grid.Row="2" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Tick0" Style="{StaticResource McSecondary}" />
            <TextBlock x:Name="Tick1" Grid.Column="1" Style="{StaticResource McSecondary}" />
            <TextBlock x:Name="Tick2" Grid.Column="2" Style="{StaticResource McSecondary}" />
            <TextBlock x:Name="Tick3" Grid.Column="3" Style="{StaticResource McSecondary}" />
            <TextBlock x:Name="Tick4" Grid.Column="3" Style="{StaticResource McSecondary}" HorizontalAlignment="Right" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="6">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="Empty" x:Uid="Timeline_Empty" Grid.Row="3" Style="{StaticResource McSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</UserControl>
