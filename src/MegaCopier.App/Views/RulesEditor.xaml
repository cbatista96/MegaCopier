<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.RulesEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RulesGrid" ColumnSpacing="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filtros -->
        <StackPanel x:Name="FiltersColumn" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon VerticalAlignment="Center" Glyph="&#xE71C;" FontSize="14" Foreground="{StaticResource McAccentBrush}" />
                <TextBlock x:Uid="Rules_Filters" Style="{StaticResource McStrong}" />
            </StackPanel>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="DescribeBox" x:Uid="Rules_Describe" KeyDown="Describe_KeyDown" TextWrapping="Wrap" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource McButton}" Click="Describe_Click"><TextBlock x:Uid="Rules_DescribeApply" /></Button>
            </Grid>
            <TextBlock x:Name="DescribeResult" Style="{StaticResource McSecondary}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBox x:Name="IncludeBox" x:Uid="Rules_Include" LostFocus="Changed" />
            <TextBox x:Name="ExcludeBox" x:Uid="Rules_Exclude" LostFocus="Changed" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="MinSizeBox" x:Uid="Rules_MinSize" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
                <NumberBox x:Name="MaxSizeBox" x:Uid="Rules_MaxSize" Grid.Column="1" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CalendarDatePicker x:Name="AfterBox" x:Uid="Rules_After" HorizontalAlignment="Stretch" DateChanged="Date_Changed" />
                <CalendarDatePicker x:Name="BeforeBox" x:Uid="Rules_Before" Grid.Column="1" HorizontalAlignment="Stretch" DateChanged="Date_Changed" />
            </Grid>
            <CheckBox x:Name="SkipHiddenBox" x:Uid="Rules_SkipHidden" Click="Changed" />
            <CheckBox x:Name="SkipSystemBox" x:Uid="Rules_SkipSystem" Click="Changed" />
            <CheckBox x:Name="SkipJunkBox" x:Uid="Rules_SkipJunk" Click="Changed" />
        </StackPanel>

        <!-- Reglas -->
        <StackPanel x:Name="RulesColumn" Grid.Column="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon VerticalAlignment="Center" Glyph="&#xE71B;" FontSize="14" Foreground="{StaticResource McAccentBrush}" />
                <TextBlock x:Uid="Rules_Rules" Style="{StaticResource McStrong}" />
            </StackPanel>
            <ComboBox x:Name="LinksBox" x:Uid="Rules_Links" HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed">
                <ComboBoxItem x:Uid="Rules_LinksCopy" />
                <ComboBoxItem x:Uid="Rules_LinksFollow" />
                <ComboBoxItem x:Uid="Rules_LinksSkip" />
            </ComboBox>
            <TextBox x:Name="PatternBox" x:Uid="Rules_Pattern" TextChanged="Pattern_TextChanged" LostFocus="Changed" />
            <TextBlock x:Name="PatternPreview" Style="{StaticResource McSecondary}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="RetriesBox" x:Uid="Rules_Retries" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
                <NumberBox x:Name="DelayBox" x:Uid="Rules_Delay" Grid.Column="1" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
            </Grid>
            <ComboBox x:Name="OnErrorBox" x:Uid="Rules_OnError" HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed">
                <ComboBoxItem x:Uid="Rules_OnErrorSkip" />
                <ComboBoxItem x:Uid="Rules_OnErrorStop" />
                <ComboBoxItem x:Uid="Rules_OnErrorEnd" />
            </ComboBox>
        </StackPanel>

        <!-- Sincronización y seguridad -->
        <StackPanel x:Name="SafetyHeader" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,-8">
            <FontIcon VerticalAlignment="Center" Glyph="&#xE8F7;" FontSize="14" Foreground="{StaticResource McAccentBrush}" />
            <TextBlock x:Uid="Rules_Safety" Style="{StaticResource McStrong}" />
        </StackPanel>
        <StackPanel x:Name="SafetyLeft" Grid.Row="2" Spacing="8">
            <ComboBox x:Name="FolderConflictBox" x:Uid="Rules_FolderConflict" HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed">
                <ComboBoxItem x:Uid="Rules_FolderMerge" />
                <ComboBoxItem x:Uid="Rules_FolderSkip" />
            </ComboBox>
            <TextBox x:Name="VersionsBox" x:Uid="Rules_Versions" LostFocus="Changed" />
            <TextBox x:Name="AlternatesBox" x:Uid="Rules_Alternates" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" LostFocus="Changed" />
            <ComboBox x:Name="VersionsKeepBox" x:Uid="Rules_VersionsKeep" HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed">
                <ComboBoxItem x:Uid="Rules_VersionsAll" />
                <ComboBoxItem x:Uid="Rules_VersionsWeek" />
                <ComboBoxItem x:Uid="Rules_VersionsMonth" />
                <ComboBoxItem x:Uid="Rules_VersionsLast" />
            </ComboBox>
            <NumberBox x:Name="ToleranceBox" x:Uid="Rules_Tolerance" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed" />
        </StackPanel>
        <StackPanel x:Name="SafetyRight" Grid.Row="2" Grid.Column="1" Spacing="2">
            <CheckBox x:Name="VerifySourceBox" x:Uid="Rules_VerifySource" Click="Changed" />
            <CheckBox x:Name="HashStreamBox" x:Uid="Rules_HashStream" Click="Changed" />
            <CheckBox x:Name="HardLinksBox" x:Uid="Rules_HardLinks" Click="Changed" />
            <CheckBox x:Name="WipeBox" x:Uid="Rules_Wipe" Click="Changed" />
            <ComboBox x:Name="WipeMethodBox" x:Uid="Rules_WipeMethod" HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed">
                <ComboBoxItem x:Uid="Rules_WipeZeros" />
                <ComboBoxItem x:Uid="Rules_WipeRandom" />
                <ComboBoxItem x:Uid="Rules_WipeDod3" />
                <ComboBoxItem x:Uid="Rules_WipeDod7" />
            </ComboBox>
            <CheckBox x:Name="EfsRawBox" x:Uid="Rules_EfsRaw" Click="Changed" />
            <CheckBox x:Name="ShieldBox" x:Uid="Rules_Shield" Click="Changed" />
            <CheckBox x:Name="ForensicBox" x:Uid="Rules_Forensic" Click="Changed" />
            <ComboBox x:Name="RecoveryBox" x:Uid="Rules_Recovery" HorizontalAlignment="Stretch" SelectionChanged="Selection_Changed">
                <ComboBoxItem x:Uid="Rules_RecoveryNone" />
                <ComboBoxItem x:Uid="Rules_Recovery5" />
                <ComboBoxItem x:Uid="Rules_Recovery10" />
                <ComboBoxItem x:Uid="Rules_Recovery20" />
            </ComboBox>
            <CheckBox x:Name="WaitDeviceBox" x:Uid="Rules_WaitDevice" Click="Changed" />
            <CheckBox x:Name="WaitSpaceBox" x:Uid="Rules_WaitSpace" Click="Changed" />
            <CheckBox x:Name="AllOrNothingBox" x:Uid="Rules_AllOrNothing" Click="Changed" />
            <CheckBox x:Name="RescueBox" x:Uid="Rules_Rescue" Click="Changed" />
            <CheckBox x:Name="DeltaBox" x:Uid="Rules_Delta" Click="Changed" />
            <CheckBox x:Name="DuplicatesBox" x:Uid="Rules_Duplicates" Click="Changed" />
        </StackPanel>
    </Grid>
</UserControl>
