<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls"
    xmlns:views="using:MegaCopier.App.Views">

    <Grid Padding="20,8,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <c:McIcon VerticalAlignment="Center" Glyph="&#xE81C;" FontSize="20" Accent="True" />
                <TextBlock x:Uid="History_Title" Style="{StaticResource McTitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Style="{StaticResource McButton}" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock x:Uid="History_Clear" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McButton}" Click="Close_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock x:Uid="Page_Back" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ResultInfo" x:Uid="History_UndoTitleBar" Grid.Row="1" Severity="Success" IsOpen="False" />
        <ListView x:Name="List" Grid.Row="2" SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:HistoryRow">
                    <Border Style="{StaticResource McCard}" Margin="0,4">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center" Background="{StaticResource McSurfaceStrongBrush}">
                                <c:McIcon Glyph="{x:Bind Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Bind StateBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource McStrong}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Route}" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullRoute}" />
                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource McSecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Style="{StaticResource McToolButton}" Click="{x:Bind Repeat}" x:Uid="History_Repeat">
                                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource McToolButton}" Click="{x:Bind Undo}" x:Uid="History_Undo" Visibility="{x:Bind CanUndo}">
                                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE7A7;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource McToolButton}" Click="{x:Bind CopyBack}" x:Uid="History_CopyBack" Visibility="{x:Bind IsCopy}">
                                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE8EE;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource McToolButton}" Click="{x:Bind OpenDestination}" x:Uid="History_Open">
                                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" x:Uid="History_Empty" Grid.Row="2" Style="{StaticResource McSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <ContentDialog x:Name="UndoDialog" x:Uid="History_UndoDialog" Grid.RowSpan="3" Style="{StaticResource DefaultContentDialogStyle}" DefaultButton="Close">
            <TextBlock x:Name="UndoMessage" TextWrapping="Wrap" MaxWidth="440" />
        </ContentDialog>
    </Grid>
</UserControl>
