<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MegaCopier.App.Views">

    <Grid Padding="20,8,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="{StaticResource McAccentBrush}" />
                <TextBlock x:Uid="History_Title" Style="{StaticResource McTitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Style="{StaticResource McButton}" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock x:Uid="History_Clear" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McButton}" Click="Close_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock x:Uid="Page_Back" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="List" Grid.Row="1" SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:HistoryRow">
                    <Border Style="{StaticResource McCard}" Margin="0,4">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{StaticResource McAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource McStrong}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Route}" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullRoute}" />
                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource McSecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Style="{StaticResource McToolButton}" Click="{x:Bind Repeat}" x:Uid="History_Repeat">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource McToolButton}" Click="{x:Bind OpenDestination}" x:Uid="History_Open">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" x:Uid="History_Empty" Grid.Row="1" Style="{StaticResource McSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
