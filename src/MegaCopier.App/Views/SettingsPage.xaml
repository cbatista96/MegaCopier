<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls"
    xmlns:views="using:MegaCopier.App.Views">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="20,8,20,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <c:BackButton Click="Close_Click" Margin="-8,0,0,0" />
                <c:McIcon VerticalAlignment="Center" Glyph="&#xE713;" FontSize="20" Accent="True" />
                <!-- Compensación óptica: el centro de la tinta del texto coincide con los iconos. -->
                <TextBlock x:Uid="SettingsSection" Style="{StaticResource McTitle}" VerticalAlignment="Center" TextLineBounds="Tight">
                    <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Secciones, como en la Configuración de Windows 11 -->
            <Grid x:Name="NavPane" Padding="12,4,6,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" x:Uid="Settings_Search" QueryIcon="Find" TextChanged="Search_TextChanged" />
                <ListView x:Name="SectionList" Grid.Row="1" SelectionMode="Single" SelectionChanged="Section_SelectionChanged">
                    <ListView.Resources><x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean></ListView.Resources>
                </ListView>
                <!-- La barrita de la sección elegida: se desliza de una a otra -->
                <Canvas x:Name="SectionIndicatorLayer" Grid.Row="1" IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Column="1" MaxWidth="1028" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="SectionHeader" HorizontalAlignment="Stretch" ColumnSpacing="12" Margin="24,6,24,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <c:McIcon x:Name="SectionIcon" FontSize="26" Accent="True" VerticalAlignment="Center" />
                    <TextBlock x:Name="SectionTitle" Grid.Column="1" Style="{StaticResource McTitle}" FontSize="26" TextLineBounds="Tight" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <BreadcrumbBar x:Name="UpdatesBreadcrumb" Grid.Column="1" Visibility="Collapsed" Height="44" VerticalAlignment="Center" ItemClicked="UpdatesBreadcrumb_Clicked">
                        <BreadcrumbBar.Resources>
                            <x:Double x:Key="BreadcrumbBarItemThemeFontSize">26</x:Double>
                            <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                            <Thickness x:Key="BreadcrumbBarChevronPadding">8,0</Thickness>
                            <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                        </BreadcrumbBar.Resources>
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontSize="26" FontWeight="SemiBold" TextLineBounds="Full" VerticalAlignment="Center" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                </Grid>
                <ScrollViewer x:Name="SectionScroll" HorizontalContentAlignment="Stretch" Grid.Row="1" Padding="24,0,24,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsHost" MaxWidth="980" HorizontalAlignment="Stretch">
                <InfoBar x:Name="RestartInfo" x:Uid="RestartInfo" Severity="Informational" IsClosable="False" IsOpen="False" Margin="0,8,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartButton" Click="Restart_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="Sec_General" Visibility="Collapsed">
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE7E8;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="EnabledTitleLabel" x:Uid="Settings_EnabledTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_EnabledDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="EnabledToggle" AutomationProperties.LabeledBy="{x:Bind EnabledTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xF2B7;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="LanguageTitleLabel" x:Uid="LanguageTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="LanguageDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="LanguageBox" AutomationProperties.LabeledBy="{x:Bind LanguageTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Language_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE77F;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PasteTitleLabel" x:Uid="PasteTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" VerticalAlignment="Center" /><c:InfoTip Grid.Column="1" Topic="Paste" Margin="0,-4,0,-4" /></Grid><TextBlock x:Uid="PasteDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="PasteToggle" AutomationProperties.LabeledBy="{x:Bind PasteTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="10">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE7C9;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="DragTitleLabel" x:Uid="DragTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" VerticalAlignment="Center" /><c:InfoTip Grid.Column="1" Topic="Drag" Margin="0,-4,0,-4" /></Grid><TextBlock x:Uid="DragDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ToggleSwitch x:Name="DragToggle" AutomationProperties.LabeledBy="{x:Bind DragTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE9CE;" FontSize="18" Foreground="Transparent" />
                            <TextBlock Grid.Column="1" x:Name="DragConfirmTitleLabel" x:Uid="DragConfirmTitle" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="DragConfirmBox" AutomationProperties.LabeledBy="{x:Bind DragConfirmTitleLabel}" Grid.Column="2" MinWidth="200" SelectionChanged="Selection_Changed">
                                <ComboBoxItem x:Uid="DragConfirm_Never" />
                                <ComboBoxItem x:Uid="DragConfirm_Moves" />
                                <ComboBoxItem x:Uid="DragConfirm_Always" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE8A9;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="ShellMenuTitleLabel" x:Uid="ShellMenuTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="ShellMenuDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="ShellMenuToggle" AutomationProperties.LabeledBy="{x:Bind ShellMenuTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="ShellMenu_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE7B5;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="StartupTitleLabel" x:Uid="StartupTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="StartupDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" AutomationProperties.LabeledBy="{x:Bind StartupTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE8A7;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><TextBlock x:Name="TrayTitleLabel" x:Uid="Settings_TrayTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_TrayDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ToggleSwitch x:Name="TrayToggle" AutomationProperties.LabeledBy="{x:Bind TrayTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE9D9;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><TextBlock x:Name="TrayProgressTitleLabel" x:Uid="Settings_TrayProgressTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_TrayProgressDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ToggleSwitch x:Name="TrayProgressToggle" AutomationProperties.LabeledBy="{x:Bind TrayProgressTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE9D9;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="UnitsTitleLabel" x:Uid="Settings_UnitsTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_UnitsDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="UnitsBox" AutomationProperties.LabeledBy="{x:Bind UnitsTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Units_Classic" /><ComboBoxItem x:Uid="Units_Iec" /><ComboBoxItem x:Uid="Units_Decimal" />
                        </ComboBox>
                    </Grid>
                </Border>
                </StackPanel>                <StackPanel x:Name="Sec_Interface" Visibility="Collapsed">
                <TextBlock x:Uid="Settings_Window" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE737;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="WindowModeTitleLabel" x:Uid="Settings_WindowModeTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" VerticalAlignment="Center" /><c:InfoTip Grid.Column="1" Topic="WindowMode" Margin="0,-4,0,-4" /></Grid><TextBlock x:Uid="Settings_WindowModeDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="WindowModeBox" AutomationProperties.LabeledBy="{x:Bind WindowModeTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Settings_ModeAuto" /><ComboBoxItem x:Uid="Settings_ModeCompact" /><ComboBoxItem x:Uid="Settings_ModeExpanded" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE8BB;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="FinishTitleLabel" x:Uid="Settings_FinishTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_FinishDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="FinishWindowBox" AutomationProperties.LabeledBy="{x:Bind FinishTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Settings_FinishAuto" /><ComboBoxItem x:Uid="Settings_FinishClose" /><ComboBoxItem x:Uid="Settings_FinishKeep" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE711;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="CloseButtonTitleLabel" x:Uid="Settings_CloseButtonTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" VerticalAlignment="Center" /><c:InfoTip Grid.Column="1" Topic="CloseButton" Margin="0,-4,0,-4" /></Grid><TextBlock x:Uid="Settings_CloseButtonDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="CloseButtonBox" AutomationProperties.LabeledBy="{x:Bind CloseButtonTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="CloseButton_Cancel" /><ComboBoxItem x:Uid="CloseButton_Stop" /><ComboBoxItem x:Uid="CloseButton_Hide" /><ComboBoxItem x:Uid="CloseButton_Exit" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE921;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MinimizeButtonTitleLabel" x:Uid="Settings_MinimizeButtonTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" VerticalAlignment="Center" /><c:InfoTip Grid.Column="1" Topic="MinimizeButton" Margin="0,-4,0,-4" /></Grid><TextBlock x:Uid="Settings_MinimizeButtonDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="MinimizeButtonBox" AutomationProperties.LabeledBy="{x:Bind MinimizeButtonTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="MinimizeButton_Taskbar" /><ComboBoxItem x:Uid="MinimizeButton_Tray" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE718;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="OnTopTitleLabel" x:Uid="OnTopTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="OnTopDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="OnTopToggle" AutomationProperties.LabeledBy="{x:Bind OnTopTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xEA8F;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="NotifyTitleLabel" x:Uid="NotifyTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="NotifyDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="NotifyToggle" AutomationProperties.LabeledBy="{x:Bind NotifyTitleLabel}" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE921;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><TextBlock x:Name="StartMinimizedTitleLabel" x:Uid="Settings_StartMinimizedTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_StartMinimizedDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedToggle" AutomationProperties.LabeledBy="{x:Bind StartMinimizedTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE740;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><TextBlock x:Name="RememberTitleLabel" x:Uid="Settings_RememberTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_RememberDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"><CheckBox x:Name="RememberPositionBox" x:Uid="Settings_RememberPosition" Click="Changed" MinWidth="0" /><CheckBox x:Name="RememberSizeBox" x:Uid="Settings_RememberSize" Click="Changed" MinWidth="0" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE81E;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="BackdropTitleLabel" x:Uid="Settings_BackdropTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" VerticalAlignment="Center" /><c:InfoTip Grid.Column="1" Topic="Backdrop" Margin="0,-4,0,-4" /></Grid><TextBlock x:Uid="Settings_BackdropDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ComboBox x:Name="BackdropBox" AutomationProperties.LabeledBy="{x:Bind BackdropTitleLabel}" Grid.Column="2" MinWidth="220" SelectionChanged="Backdrop_Changed">
                                <ComboBoxItem x:Uid="Backdrop_OptTheme" /><ComboBoxItem x:Uid="BackdropMica" /><ComboBoxItem x:Uid="BackdropMicaAlt" /><ComboBoxItem x:Uid="BackdropAcrylic" /><ComboBoxItem x:Uid="Backdrop_OptTranslucent" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE7F4;" FontSize="18" Accent="True" />
                        <StackPanel Grid.Column="1"><TextBlock x:Name="AdaptTitleLabel" x:Uid="Settings_AdaptTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_AdaptDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="AdaptToggle" AutomationProperties.LabeledBy="{x:Bind AdaptTitleLabel}" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <TextBlock x:Name="ThemesLabel" x:Uid="Settings_Themes" Style="{StaticResource McSection}" />
                <GridView x:Name="ThemeGallery" AutomationProperties.LabeledBy="{x:Bind ThemesLabel}" SelectionMode="Single" SelectionChanged="ThemeGallery_SelectionChanged" Padding="4,4,4,0">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="views:ThemeTile">
                            <StackPanel Width="168" Spacing="6" Padding="4">
                                <Border Height="92" CornerRadius="8" Background="{x:Bind WindowBrush}" BorderBrush="{x:Bind BorderBrush}" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="7">
                                        <Border Height="10" Width="70" HorizontalAlignment="Left" CornerRadius="3" Background="{x:Bind SurfaceBrush}" />
                                        <Border Height="8" CornerRadius="4" Background="{x:Bind TrackBrush}">
                                            <Border Width="104" HorizontalAlignment="Left" CornerRadius="4" Background="{x:Bind TotalBrush}" />
                                        </Border>
                                        <Border Height="8" CornerRadius="4" Background="{x:Bind TrackBrush}">
                                            <Border Width="56" HorizontalAlignment="Left" CornerRadius="4" Background="{x:Bind FileBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Height="14" Width="38" CornerRadius="4" Background="{x:Bind AccentBrush}" />
                                            <Border Height="14" Width="38" CornerRadius="4" Background="{x:Bind SurfaceBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource McBody}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Expander x:Name="EditorExpander" AutomationProperties.LabeledBy="{x:Bind ThemeCustomizeLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE790;" FontSize="16" Accent="True" />
                            <TextBlock x:Name="ThemeCustomizeLabel" x:Uid="Theme_Customize" Style="{StaticResource McBody}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ThemeNameBox" x:Uid="Theme_Name" TextChanged="ThemeName_Changed" />
                            <ComboBox x:Name="ThemeBaseBox" AutomationProperties.LabeledBy="{x:Bind ThemeCustomizeLabel}" Grid.Column="1" MinWidth="140" SelectionChanged="ThemeEditor_Changed">
                                <ComboBoxItem x:Uid="ThemeDark" /><ComboBoxItem x:Uid="ThemeLight" />
                            </ComboBox>
                            <ComboBox x:Name="ThemeBackdropBox" AutomationProperties.LabeledBy="{x:Bind ThemeCustomizeLabel}" Grid.Column="2" MinWidth="170" SelectionChanged="ThemeEditor_Changed">
                                <ComboBoxItem x:Uid="BackdropMica" /><ComboBoxItem x:Uid="BackdropMicaAlt" /><ComboBoxItem x:Uid="BackdropAcrylic" /><ComboBoxItem x:Uid="BackdropSolid" /><ComboBoxItem x:Uid="BackdropAcrylicThin" />
                            </ComboBox>
                        </Grid>
                        <VariableSizedWrapGrid x:Name="ColorSlots" Orientation="Horizontal" ItemWidth="210" ItemHeight="44" />
