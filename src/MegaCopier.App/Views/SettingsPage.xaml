                        <StackPanel x:Name="DiskList" Spacing="4" Margin="30,0,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><TextBlock x:Name="DataTitleLabel" x:Uid="Settings_DataTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_DataDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource McButton}" Click="OpenData_Click" AutomationProperties.LabeledBy="{x:Bind DataTitleLabel}"><TextBlock x:Uid="Settings_LogsOpen" /></Button>
                        </Grid>
                        <TextBlock x:Name="DataFolderText" Style="{StaticResource McSecondary}" Margin="30,0,0,0" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}" Tag="SettingRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE777;" FontSize="18" Accent="True" />
                            <StackPanel Grid.Column="1"><TextBlock x:Name="ResetTitleLabel" x:Uid="Settings_ResetTitle" Style="{StaticResource McBody}" TextWrapping="Wrap" /><TextBlock x:Uid="Settings_ResetDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource McButton}" Click="Reset_Click" AutomationProperties.LabeledBy="{x:Bind ResetTitleLabel}"><TextBlock x:Uid="Settings_ResetButton" /></Button>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="Sec_Updates" Visibility="Collapsed" />
                <TextBlock x:Name="SearchEmpty" Style="{StaticResource McSecondary}" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
