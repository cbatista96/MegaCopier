<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MegaCopier.App.Views">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="20,8,20,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon VerticalAlignment="Center" Glyph="&#xE713;" FontSize="20" Foreground="{StaticResource McAccentBrush}" />
                <TextBlock x:Uid="SettingsSection" Style="{StaticResource McTitle}" />
            </StackPanel>
            <Button Style="{StaticResource McButton}" Click="Close_Click" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock x:Uid="Page_Back" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <InfoBar x:Name="RestartInfo" x:Uid="RestartInfo" Severity="Informational" IsClosable="False" IsOpen="False" Margin="0,8,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartButton" Click="Restart_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- General -->
                <TextBlock x:Uid="Settings_General" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE7E8;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_EnabledTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_EnabledDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="EnabledToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE77F;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="PasteTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="PasteDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="PasteToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8A9;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="ShellMenuTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="ShellMenuDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="ShellMenuToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="ShellMenu_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE7B5;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="StartupTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="StartupDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Startup_Toggled" />
                    </Grid>
                </Border>

                <!-- Ventana -->
                <TextBlock x:Uid="Settings_Window" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE737;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_WindowModeTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_WindowModeDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="WindowModeBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Settings_ModeAuto" /><ComboBoxItem x:Uid="Settings_ModeCompact" /><ComboBoxItem x:Uid="Settings_ModeExpanded" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8BB;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_FinishTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_FinishDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="FinishWindowBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Settings_FinishAuto" /><ComboBoxItem x:Uid="Settings_FinishClose" /><ComboBoxItem x:Uid="Settings_FinishKeep" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE718;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="OnTopTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="OnTopDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="OnTopToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xEA8F;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="NotifyTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="NotifyDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="NotifyToggle" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xF2B7;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="LanguageTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="LanguageDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="220" SelectionChanged="Language_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE9D9;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_UnitsTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_UnitsDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="UnitsBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Units_Classic" /><ComboBoxItem x:Uid="Units_Iec" /><ComboBoxItem x:Uid="Units_Decimal" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Sonidos -->
                <TextBlock x:Uid="Settings_Sounds" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE995;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_SoundsTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_SoundsDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="SoundBox" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE767;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <Slider x:Name="VolumeSlider" x:Uid="Settings_Volume" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="Volume_Changed" />
                            <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource McSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,8" MinWidth="40" TextAlignment="Right" />
                        </Grid>
                        <CheckBox x:Name="QuietBox" x:Uid="Settings_SoundsQuiet" Click="Changed" Margin="30,0,0,0" />
                        <StackPanel x:Name="SoundRows" Spacing="6" Margin="30,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Temas -->
                <TextBlock x:Uid="Settings_Themes" Style="{StaticResource McSection}" />
                <GridView x:Name="ThemeGallery" SelectionMode="Single" SelectionChanged="ThemeGallery_SelectionChanged" Margin="-4,0,0,0">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="views:ThemeTile">
                            <StackPanel Width="168" Spacing="6" Padding="4">
                                <Border Height="92" CornerRadius="8" Background="{x:Bind WindowBrush}" BorderBrush="{x:Bind BorderBrush}" BorderThickness="1" Padding="10">
                                    <StackPanel Spacing="7">
                                        <Border Height="10" Width="70" HorizontalAlignment="Left" CornerRadius="3" Background="{x:Bind SurfaceBrush}" />
                                        <Border Height="8" CornerRadius="4" Background="{x:Bind TrackBrush}">
                                            <Border Width="104" HorizontalAlignment="Left" CornerRadius="4" Background="{x:Bind TotalBrush}" />
                                        </Border>
                                        <Border Height="8" CornerRadius="4" Background="{x:Bind TrackBrush}">
                                            <Border Width="56" HorizontalAlignment="Left" CornerRadius="4" Background="{x:Bind FileBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Height="14" Width="38" CornerRadius="4" Background="{x:Bind AccentBrush}" />
                                            <Border Height="14" Width="38" CornerRadius="4" Background="{x:Bind SurfaceBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource McBody}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Expander x:Name="EditorExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE790;" FontSize="16" Foreground="{StaticResource McAccentBrush}" />
                            <TextBlock x:Uid="Theme_Customize" Style="{StaticResource McBody}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ThemeNameBox" x:Uid="Theme_Name" TextChanged="ThemeName_Changed" />
                            <ComboBox x:Name="ThemeBaseBox" Grid.Column="1" MinWidth="140" SelectionChanged="ThemeEditor_Changed">
                                <ComboBoxItem x:Uid="ThemeDark" /><ComboBoxItem x:Uid="ThemeLight" />
                            </ComboBox>
                            <ComboBox x:Name="ThemeBackdropBox" Grid.Column="2" MinWidth="170" SelectionChanged="ThemeEditor_Changed">
                                <ComboBoxItem x:Uid="BackdropMica" /><ComboBoxItem x:Uid="BackdropMicaAlt" /><ComboBoxItem x:Uid="BackdropAcrylic" /><ComboBoxItem x:Uid="BackdropSolid" />
                            </ComboBox>
                        </Grid>
                        <VariableSizedWrapGrid x:Name="ColorSlots" Orientation="Horizontal" ItemWidth="210" ItemHeight="44" />
                        <StackPanel x:Name="SlotEditor" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="SlotTitle" Style="{StaticResource McStrong}" />
                            <ColorPicker x:Name="SlotPicker" HorizontalAlignment="Left" IsAlphaEnabled="True" IsMoreButtonVisible="False" IsColorChannelTextInputVisible="True" IsColorSliderVisible="True" IsHexInputVisible="True" ColorSpectrumShape="Ring" ColorChanged="SlotPicker_ColorChanged" />
                        </StackPanel>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Slider x:Name="RadiusSlider" x:Uid="Theme_Radius" Minimum="0" Maximum="16" StepFrequency="1" ValueChanged="ThemeSlider_Changed" />
                            <Slider x:Name="BarSlider" x:Uid="Theme_BarHeight" Grid.Column="1" Minimum="4" Maximum="20" StepFrequency="1" ValueChanged="ThemeSlider_Changed" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource McAccentButton}" Click="ThemeSave_Click"><TextBlock x:Name="ThemeSaveText" /></Button>
                            <Button Style="{StaticResource McButton}" Click="ThemeDelete_Click" x:Name="ThemeDeleteButton"><TextBlock x:Uid="Theme_Delete" /></Button>
                            <Button Style="{StaticResource McButton}" Click="ThemeImport_Click"><TextBlock x:Uid="Theme_Import" /></Button>
                            <Button Style="{StaticResource McButton}" Click="ThemeExport_Click"><TextBlock x:Uid="Theme_Export" /></Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Copia -->
                <TextBlock x:Uid="CopyHeader" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE9D5;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="VerifyTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="VerifyDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="VerifyToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8C8;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="ConflictTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="ConflictDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="ConflictBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="ConflictAsk" /><ComboBoxItem x:Uid="ConflictReplace" /><ComboBoxItem x:Uid="ConflictSkip" /><ComboBoxItem x:Uid="ConflictNewer" /><ComboBoxItem x:Uid="ConflictKeepBoth" /><ComboBoxItem x:Uid="ConflictDifferentSize" /><ComboBoxItem x:Uid="ConflictRenameExisting" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE72E;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_HashTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_HashDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="HashBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <TextBlock x:Uid="Settings_WhatToCopy" Style="{StaticResource McBody}" VerticalAlignment="Center" />
                        </StackPanel>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="300" ItemHeight="40" Margin="30,4,0,0">
                            <CheckBox x:Name="TimestampsBox" x:Uid="Options_Timestamps" Click="Changed" />
                            <CheckBox x:Name="AttributesBox" x:Uid="Options_Attributes" Click="Changed" />
                            <CheckBox x:Name="StreamsBox" x:Uid="Options_Streams" Click="Changed" />
                            <CheckBox x:Name="AclBox" x:Uid="Options_Acl" Click="Changed" />
                            <CheckBox x:Name="OwnerBox" x:Uid="Options_Owner" Click="Changed" />
                            <CheckBox x:Name="AuditBox" x:Uid="Options_Audit" Click="Changed" />
                            <CheckBox x:Name="VerifySkippedBox" x:Uid="Options_VerifySkipped" Click="Changed" />
                            <CheckBox x:Name="ChecksumBox" x:Uid="Options_SaveChecksum" Click="Changed" />
                            <CheckBox x:Name="ReportBox" x:Uid="Options_ExportReport" Click="Changed" />
                            <CheckBox x:Name="FreeSpaceBox" x:Uid="Settings_FreeSpace" Click="Changed" />
                            <CheckBox x:Name="CacheBox" x:Uid="Options_SystemCache" Click="Changed" />
                            <CheckBox x:Name="SmbBox" x:Uid="Settings_SmbCompression" Click="Changed" />
                            <CheckBox x:Name="AutoResumeBox" x:Uid="Settings_AutoResume" Click="Changed" />
                        </VariableSizedWrapGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xEC4A;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_PerformanceTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_PerformanceDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="SpeedBox" Grid.Column="2" MinWidth="130" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="SpeedUnlimited" Tag="0" /><ComboBoxItem Content="10 MB/s" Tag="10" /><ComboBoxItem Content="25 MB/s" Tag="25" /><ComboBoxItem Content="50 MB/s" Tag="50" />
                            <ComboBoxItem Content="100 MB/s" Tag="100" /><ComboBoxItem Content="250 MB/s" Tag="250" /><ComboBoxItem Content="500 MB/s" Tag="500" />
                        </ComboBox>
                        <ComboBox x:Name="BufferBox" Grid.Column="3" MinWidth="100" SelectionChanged="Selection_Changed">
                            <ComboBoxItem Content="1 MB" Tag="1" /><ComboBoxItem Content="2 MB" Tag="2" /><ComboBoxItem Content="4 MB" Tag="4" /><ComboBoxItem Content="8 MB" Tag="8" /><ComboBoxItem Content="16 MB" Tag="16" />
                        </ComboBox>
                        <NumberBox x:Name="ThreadsBox" x:Uid="Options_ThreadsShort" Grid.Column="4" Minimum="1" Maximum="16" SpinButtonPlacementMode="Compact" MinWidth="110" ValueChanged="Number_Changed" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource McSettingCard}">
                    <views:RulesEditor x:Name="Rules" />
                </Border>

                <!-- Favoritos -->
                <TextBlock x:Uid="Settings_Favorites" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE734;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_FavoritesTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_FavoritesDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource McButton}" Click="AddFavorite_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" Glyph="&#xE710;" FontSize="12" /><TextBlock x:Uid="Settings_FavoritesAdd" /></StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="FavoritesList" Spacing="4" Margin="30,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Recibir de otros equipos -->
                <TextBlock x:Uid="Settings_Peer" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="10">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE968;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_PeerTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_PeerDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ToggleSwitch x:Name="ReceiveToggle" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Receive_Toggled" />
                        </Grid>
                        <StackPanel x:Name="ReceivePanel" Spacing="8" Margin="30,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Uid="Settings_PeerCode" Style="{StaticResource McSecondary}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReceiveCodeText" FontFamily="Consolas" FontSize="20" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                <Button Style="{StaticResource McButton}" Click="NewCode_Click"><TextBlock x:Uid="Settings_PeerNewCode" /></Button>
                            </StackPanel>
                            <TextBlock x:Name="ReceiveInfo" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReceiveFolderText" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Style="{StaticResource McButton}" Click="ReceiveFolder_Click"><TextBlock x:Uid="Settings_PeerFolder" /></Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Tareas programadas -->
                <TextBlock x:Uid="Settings_Tasks" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE823;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_TasksTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_TasksDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        </Grid>
                        <StackPanel x:Name="TasksList" Spacing="4" Margin="30,0,0,0" />
                    </StackPanel>
                </Border>
                <!-- Guardián de integridad -->
                <TextBlock x:Uid="Settings_Guard" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE83D;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_GuardTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_GuardDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <ComboBox x:Name="GuardIntervalBox" Grid.Column="2" MinWidth="160" SelectionChanged="Selection_Changed">
                                <ComboBoxItem x:Uid="Guard_Daily" Tag="1" /><ComboBoxItem x:Uid="Guard_Weekly" Tag="7" /><ComboBoxItem x:Uid="Guard_Monthly" Tag="30" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="GuardList" Spacing="4" Margin="30,0,0,0" />
                        <Button Margin="30,0,0,0" Click="AddGuarded_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" Glyph="&#xE710;" FontSize="12" /><TextBlock x:Uid="Settings_GuardAdd" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- Cola -->
                <TextBlock x:Uid="Settings_Queue" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8FD;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_MaxJobsTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_MaxJobsDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <NumberBox x:Name="MaxJobsBox" Grid.Column="2" Minimum="0" Maximum="32" SpinButtonPlacementMode="Inline" MinWidth="140" ValueChanged="Number_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE945;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_FastTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_FastDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <TextBox x:Name="FastBox" Grid.Column="2" MinWidth="220" PlaceholderText="C:, D:\Datos" LostFocus="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_SlowTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_SlowDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="SlowBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Slow_Off" Tag="0" /><ComboBoxItem Content="5 MB/s" Tag="5" /><ComboBoxItem Content="20 MB/s" Tag="20" />
                            <ComboBoxItem Content="50 MB/s" Tag="50" /><ComboBoxItem Content="100 MB/s" Tag="100" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE823;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_ScheduleLimitTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_ScheduleLimitDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="ScheduleLimitBox" Grid.Column="2" MinWidth="160" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Slow_Off" Tag="0" /><ComboBoxItem Content="5 MB/s" Tag="5" /><ComboBoxItem Content="20 MB/s" Tag="20" />
                            <ComboBoxItem Content="50 MB/s" Tag="50" /><ComboBoxItem Content="100 MB/s" Tag="100" />
                        </ComboBox>
                        <StackPanel x:Name="ScheduleLimitTimes" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="Settings_ScheduleFrom" VerticalAlignment="Center" Style="{StaticResource McSecondary}" />
                            <TimePicker x:Name="ScheduleFromBox" ClockIdentifier="24HourClock" MinWidth="120" TimeChanged="Time_Changed" />
                            <TextBlock x:Uid="Settings_ScheduleTo" VerticalAlignment="Center" Style="{StaticResource McSecondary}" />
                            <TimePicker x:Name="ScheduleToBox" ClockIdentifier="24HourClock" MinWidth="120" TimeChanged="Time_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE83F;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_PauseBatteryTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_PauseBatteryDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="PauseBatteryToggle" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE7FC;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_PauseFullTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_PauseFullDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="PauseFullToggle" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>

                <!-- Avanzado -->
                <TextBlock x:Uid="Settings_Advanced" Style="{StaticResource McSection}" />
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE9F5;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_PriorityTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_PriorityDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="PriorityBox" Grid.Column="2" MinWidth="220" SelectionChanged="Selection_Changed">
                            <ComboBoxItem x:Uid="Priority_Low" /><ComboBoxItem x:Uid="Priority_BelowNormal" /><ComboBoxItem x:Uid="Priority_Normal" /><ComboBoxItem x:Uid="Priority_AboveNormal" /><ComboBoxItem x:Uid="Priority_High" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE756;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Options_Scripts" Style="{StaticResource McBody}" /><TextBlock x:Uid="Options_ScriptsHelp" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <TextBox x:Name="ScriptsBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" LostFocus="Changed" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE9F9;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_LogsTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_LogsDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource McButton}" Click="OpenLogs_Click"><TextBlock x:Uid="Settings_LogsOpen" /></Button>
                        <ToggleSwitch x:Name="LogsToggle" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Toggled="Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource McSettingCard}">
                    <Grid Style="{StaticResource Row}" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE774;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_WebhookTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_WebhookDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="WebhookBox" x:Uid="Settings_WebhookBox" LostFocus="Changed" />
                            <Button Grid.Column="1" Style="{StaticResource McButton}" Click="TestWebhook_Click"><TextBlock x:Uid="Settings_WebhookTest" /></Button>
                        </Grid>
                        <TextBlock x:Name="WebhookResult" Grid.Row="2" Grid.Column="1" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource McSettingCard}">
                    <StackPanel Spacing="8">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xEDA2;" FontSize="18" Foreground="{StaticResource McAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock x:Uid="Settings_DisksTitle" Style="{StaticResource McBody}" /><TextBlock x:Uid="Settings_DisksDescription" Style="{StaticResource McSecondary}" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource McButton}" Click="CheckDisks_Click"><TextBlock x:Uid="Settings_DisksCheck" /></Button>
                        </Grid>
                        <StackPanel x:Name="DiskList" Spacing="4" Margin="30,0,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AboutText" Style="{StaticResource McSecondary}" Margin="2,20,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
