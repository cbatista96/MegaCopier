<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.StatusTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls">

    <!-- Con poca altura se desplaza en lugar de cortar la tabla. -->
    <ScrollViewer Background="Transparent" x:Name="Scroller">
    <StackPanel Spacing="12">
        <c:SpeedGraph x:Name="Graph" Height="200" />

        <Border x:Name="TableCard" Style="{StaticResource McCard}" Padding="16,10">
            <Grid x:Name="Table" RowSpacing="6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Uid="Status_Category" Style="{StaticResource McStrong}" />
                <TextBlock x:Uid="Status_Files" Grid.Column="1" Style="{StaticResource McStrong}" TextAlignment="Right" MinWidth="90" />
                <TextBlock x:Uid="Status_Bytes" Grid.Column="2" Style="{StaticResource McStrong}" TextAlignment="Right" MinWidth="150" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource McSuccessBrush}" /><TextBlock x:Uid="Status_Copied" Style="{StaticResource McBody}" /></StackPanel>
                <TextBlock x:Name="CopiedFiles" Grid.Row="1" Grid.Column="1" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />
                <TextBlock x:Name="CopiedBytes" Grid.Row="1" Grid.Column="2" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource McSuccessBrush}" /><TextBlock x:Uid="Status_Verified" Style="{StaticResource McBody}" /></StackPanel>
                <TextBlock x:Name="VerifiedFiles" Grid.Row="2" Grid.Column="1" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />
                <TextBlock x:Name="VerifiedBytes" Grid.Row="2" Grid.Column="2" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE893;" FontSize="13" Foreground="{StaticResource McTextSecondaryBrush}" /><TextBlock x:Uid="Status_Skipped" Style="{StaticResource McBody}" /></StackPanel>
                <TextBlock x:Name="SkippedFiles" Grid.Row="3" Grid.Column="1" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />
                <TextBlock x:Name="SkippedBytes" Grid.Row="3" Grid.Column="2" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource McWarningBrush}" /><TextBlock x:Uid="Status_Failed" Style="{StaticResource McBody}" /></StackPanel>
                <TextBlock x:Name="FailedFiles" Grid.Row="4" Grid.Column="1" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />
                <TextBlock x:Name="FailedBytes" Grid.Row="4" Grid.Column="2" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE823;" FontSize="13" Foreground="{StaticResource McTextSecondaryBrush}" /><TextBlock x:Uid="Status_Pending" Style="{StaticResource McBody}" /></StackPanel>
                <TextBlock x:Name="PendingFiles" Grid.Row="5" Grid.Column="1" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />
                <TextBlock x:Name="PendingBytes" Grid.Row="5" Grid.Column="2" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" />

                <Rectangle Grid.Row="6" Grid.ColumnSpan="3" Height="1" Fill="{StaticResource McBorderBrush}" Margin="0,2" />
                <TextBlock x:Uid="Status_Total" Grid.Row="7" Style="{StaticResource McStrong}" />
                <TextBlock x:Name="TotalFiles" Grid.Row="7" Grid.Column="1" Style="{StaticResource McStrong}" TextAlignment="Right" FontFamily="Consolas" />
                <TextBlock x:Name="TotalBytes" Grid.Row="7" Grid.Column="2" Style="{StaticResource McStrong}" TextAlignment="Right" FontFamily="Consolas" />
                <!-- Carpetas que se crean en el destino (aparte de los archivos, como en TeraCopy) -->
                <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"><c:McIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource McTextSecondaryBrush}" /><TextBlock x:Uid="Status_Folders" Style="{StaticResource McBody}" /></StackPanel>
                <TextBlock x:Name="FolderCount" Grid.Row="8" Grid.Column="1" Style="{StaticResource McBody}" TextAlignment="Right" FontFamily="Consolas" Margin="0,2,0,0" />
            </Grid>
        </Border>
        <!-- Las dos unidades: tipo, sistema de archivos y espacio libre (como la pestaña Estado de TeraCopy) -->
        <Border x:Name="DrivesCard" Style="{StaticResource McCard}" Padding="16,10">
            <Grid RowSpacing="8" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <c:McIcon x:Name="SourceDriveGlyph" VerticalAlignment="Center" FontSize="16" Accent="True" />
                <TextBlock x:Uid="Status_SourceDrive" Grid.Column="1" Style="{StaticResource McStrong}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="SourceDriveName" Style="{StaticResource McBody}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SourceDriveInfo" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                </StackPanel>
                <c:McIcon x:Name="TargetDriveGlyph" Grid.Row="1" VerticalAlignment="Center" FontSize="16" Accent="True" />
                <TextBlock x:Uid="Status_TargetDrive" Grid.Row="1" Grid.Column="1" Style="{StaticResource McStrong}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TargetDriveName" Style="{StaticResource McBody}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TargetDriveInfo" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
