<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.CopyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls">

    <Grid RowSpacing="6" Padding="16,10,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Progreso total -->
        <Grid x:Name="TotalRow" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StateChip" Style="{StaticResource McChip}" MinHeight="24">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:McIcon VerticalAlignment="Center" Glyph="{x:Bind Job.Glyph, Mode=OneWay}" FontSize="12" Accent="True" />
                    <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="StateChipText" Text="{x:Bind Job.ChipText, Mode=OneWay}" Style="{StaticResource McChipText}" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Job.StateText, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Button x:Name="TitleLink" x:Uid="Panel_OpenCopied" Grid.Column="1" Style="{StaticResource McLinkButton}" VerticalAlignment="Center" Click="{x:Bind Job.OpenCopiedFolder}">
                <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" Text="{x:Bind Job.Title, Mode=OneWay}" Style="{StaticResource McStrong}" TextTrimming="CharacterEllipsis" />
            </Button>
            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="FilesCountBlock" Typography.NumeralAlignment="Tabular" TextAlignment="Right" Grid.Column="2" Text="{x:Bind Job.FilesCountText, Mode=OneWay}" Style="{StaticResource McSecondary}" />
            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="TotalBytesBlock" Typography.NumeralAlignment="Tabular" TextAlignment="Right" Grid.Column="3" Text="{x:Bind Job.TotalBytesText, Mode=OneWay}" Style="{StaticResource McSecondary}" />
            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="TotalPercentBlock" Typography.NumeralAlignment="Tabular" Grid.Column="4" Text="{x:Bind Job.TotalPercentText, Mode=OneWay}" Style="{StaticResource McStrong}" MinWidth="56" TextAlignment="Right" />
        </Grid>
        <c:FlowBar Grid.Row="1" Fill="{StaticResource McTotalBrush}"
                   Value="{x:Bind Job.TotalFraction, Mode=OneWay}"
                   IsActive="{x:Bind Job.IsRunning, Mode=OneWay}"
                   IsPaused="{x:Bind Job.IsPaused, Mode=OneWay}"
                   IsError="{x:Bind Job.IsFailed, Mode=OneWay}" IsWarning="{x:Bind Job.HasWarnings, Mode=OneWay}"
                   IsIndeterminate="{x:Bind Job.BarIndeterminate, Mode=OneWay}" />

        <!-- Archivo actual -->
        <Grid x:Name="FileRow" Grid.Row="2" ColumnSpacing="12" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="FileChip" Style="{StaticResource McChip}" MinHeight="24">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE8A5;" FontSize="12" Accent="True" />
                    <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="FileChipText" x:Uid="Panel_File" Style="{StaticResource McChipText}" />
                </StackPanel>
            </Border>
            <Button x:Uid="Panel_RevealFile" Grid.Column="1" Style="{StaticResource McLinkButton}" VerticalAlignment="Center" Click="{x:Bind Job.RevealCurrentFile}">
                <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" Text="{x:Bind Job.CurrentFileName, Mode=OneWay}" Style="{StaticResource McBody}" TextTrimming="CharacterEllipsis" />
            </Button>
            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="SpeedBlock" Typography.NumeralAlignment="Tabular" TextAlignment="Right" Grid.Column="2" Text="{x:Bind Job.SpeedAndRemaining, Mode=OneWay}" Style="{StaticResource McSecondary}" />
            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="FileBytesBlock" Typography.NumeralAlignment="Tabular" TextAlignment="Right" Grid.Column="3" Text="{x:Bind Job.FileBytesText, Mode=OneWay}" Style="{StaticResource McSecondary}" />
            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="FilePercentBlock" Typography.NumeralAlignment="Tabular" Grid.Column="4" Text="{x:Bind Job.FilePercentText, Mode=OneWay}" Style="{StaticResource McStrong}" MinWidth="56" TextAlignment="Right" />
        </Grid>
        <c:FlowBar Grid.Row="3" Role="File" Fill="{StaticResource McFileBrush}"
                   Value="{x:Bind Job.FileFraction, Mode=OneWay}"
                   IsActive="{x:Bind Job.IsRunning, Mode=OneWay}"
                   IsPaused="{x:Bind Job.IsPaused, Mode=OneWay}" />

        <!-- Unidades de origen y destino: el origen a la izquierda y el destino (con su flecha) a la derecha. El destino
             mide lo que necesita, hasta la mitad de la fila; el origen se queda con el resto -->
        <Grid x:Name="DrivesRow" Grid.Row="4" ColumnSpacing="10" Margin="0,4,0,0" SizeChanged="DrivesRow_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="Panel_RevealSource" Style="{StaticResource McLinkButton}" HorizontalAlignment="Left" Click="{x:Bind Job.RevealSource}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <c:McIcon VerticalAlignment="Center" Glyph="{x:Bind Job.SourceDriveGlyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource McTextSecondaryBrush}" />
                    <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" Grid.Column="1" Text="{x:Bind Job.SourceFolderShort, Mode=OneWay}" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
            <c:McIcon x:Name="DrivesArrow" VerticalAlignment="Center" Grid.Column="1" Glyph="&#xE72A;" FontSize="14" Accent="True" />
            <Button x:Name="DestinationButton" x:Uid="Panel_RevealDestination" Grid.Column="2" Style="{StaticResource McLinkButton}" HorizontalAlignment="Right" Click="{x:Bind Job.RevealDestination}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <c:McIcon VerticalAlignment="Center" Glyph="{x:Bind Job.DestinationDriveGlyph, Mode=OneWay}" FontSize="16" Foreground="{StaticResource McTextSecondaryBrush}" />
                    <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" Grid.Column="1" Text="{x:Bind Job.DestinationFolderShort, Mode=OneWay}" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </Grid>

        <!-- Botones -->
        <Grid Grid.Row="5" ColumnSpacing="8" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExpandButton" Style="{StaticResource McButton}" MinHeight="34" VerticalContentAlignment="Center" Click="Expand_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" x:Name="ExpandGlyph" Glyph="&#xE70D;" FontSize="12" />
                        <Grid>
                            <!-- Medir los dos textos evita mover los botones al cambiar de vista, en cualquier idioma. -->
                            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="MoreMeasure" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="LessMeasure" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="ExpandText" HorizontalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Button>
                <!-- Pausa y Continuar son el mismo botón: mide lo que el más largo de los dos textos y el icono de
                     pausa se transforma en el de reproducir (y al revés); el texto cambia sin moverse -->
                <Button x:Name="PlayPauseButton" Tag="Morph" Style="{StaticResource McButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.TogglePause}" Visibility="{x:Bind Job.CanPlayPause, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="12" VerticalAlignment="Center" />
                        <Grid>
                            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="PauseLabel" x:Uid="Panel_Pause" HorizontalAlignment="Center" />
                            <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Name="PlayLabel" Text="{x:Bind Job.ResumeLabel, Mode=OneWay}" HorizontalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McAccentButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.CopyLocked}" Visibility="{x:Bind Job.CanCopyLocked, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE7EF;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_CopyLocked" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McAccentButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.CopyAdmin}" Visibility="{x:Bind Job.CanCopyAdmin, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE7EF;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_CopyAdmin" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McAccentButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.RunForReal}" Visibility="{x:Bind Job.CanRunForReal, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE768;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_RunForReal" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.Skip}" Visibility="{x:Bind Job.CanSkip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE893;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_Skip" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.Stop}" Visibility="{x:Bind Job.CanStop, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE71A;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_Stop" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.OpenDestination}" Visibility="{x:Bind Job.IsDone, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE838;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_OpenFolder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource McButton}" MinHeight="34" VerticalContentAlignment="Center" Click="{x:Bind Job.Discard}" Visibility="{x:Bind Job.CanDiscard, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock TextLineBounds="Tight" VerticalAlignment="Center" x:Uid="Panel_Discard" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border x:Name="DetailHost" Grid.Column="1">
                <TextBlock TextLineBounds="Full" LineHeight="18" LineStackingStrategy="MaxHeight" VerticalAlignment="Center" x:Name="DetailBlock" Text="{x:Bind Job.DetailText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Job.DetailText, Mode=OneWay}" Style="{StaticResource McSecondary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Job.HasDetail, Mode=OneWay}" />
            </Border>
            <Button Grid.Column="2" x:Uid="Panel_Options" Style="{StaticResource McToolButton}">
                <c:McIcon VerticalAlignment="Center" Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <!-- Sin casillas (dejarían un hueco a la izquierda de todas las opciones): lo activado lleva una
                         marca a la derecha -->
                    <MenuFlyout Placement="TopEdgeAlignedRight" Opening="OptionsMenu_Opening">
                        <MenuFlyoutItem x:Name="UnattendedItem" x:Uid="Panel_UnattendedItem" Click="Unattended_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="VerifyItem" x:Uid="Panel_VerifyItem" Click="Verify_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Panel_OpenFolderItem" Click="{x:Bind Job.OpenDestination}"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
