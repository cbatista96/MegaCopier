<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MegaCopier.App.Views.LogTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls"
    xmlns:vm="using:MegaCopier.App.ViewModels">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource McButton}" Click="Export_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE74E;" FontSize="12" />
                    <TextBlock x:Uid="Log_Export" />
                </StackPanel>
            </Button>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Job.Log, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogRowViewModel">
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource McAccentBrush}" Visibility="{x:Bind IsInfo}" />
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource McWarningBrush}" Visibility="{x:Bind IsWarning}" />
                            <c:McIcon VerticalAlignment="Center" Glyph="&#xEA39;" FontSize="13" Foreground="{StaticResource McErrorBrush}" Visibility="{x:Bind IsError}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{StaticResource McSecondary}" FontFamily="Consolas" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Bind Message}" Style="{StaticResource McBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind PathText}" Style="{StaticResource McSecondary}" Visibility="{x:Bind HasPath}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
