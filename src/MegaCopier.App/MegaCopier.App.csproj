<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>MegaCopier.App</RootNamespace>
    <AssemblyName>MegaCopier</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>

    <!-- App sin paquete MSIX: se distribuye con un instalador normal y lleva su propio runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Necesario aunque no haya MSIX: genera MegaCopier.pri (XAML compilado) también al publicar. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>

    <!-- Main propio: la instancia única y el reenvío al proceso residente ocurren antes de cargar XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Código nativo: arranque rápido, sin JIT. -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo WinUI y su base: el metapaquete completo añade ~100 MB de componentes de IA que no se usan. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!-- Recurso de versión que Foundation 2.3.12 aún exige para registrar avisos en una app autónoma (#6774). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\MegaCopier.ico</ApplicationIcon>
    <UpdateRuntimeResource>$(BaseIntermediateOutputPath)update-runtime\$(RuntimeIdentifier)\Microsoft.WindowsAppRuntime.Insights.Resource.dll</UpdateRuntimeResource>
  </PropertyGroup>

  <!-- Solo 34 KB de recursos oficiales; no instala el runtime ni cambia WinUI o los materiales existentes. -->
  <Target Name="ExtractUpdateRuntimeResource" BeforeTargets="PrepareForBuild"
          Inputs="$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix"
          Outputs="$(UpdateRuntimeResource)">
    <Unzip SourceFiles="$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix"
           DestinationFolder="$(BaseIntermediateOutputPath)update-runtime\$(RuntimeIdentifier)"
           Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(UpdateRuntimeResource)')" Text="Falta el recurso oficial para registrar las notificaciones de actualización." />
  </Target>

  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Textures\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(UpdateRuntimeResource)" Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MegaCopier.Engine\MegaCopier.Engine.csproj" />
    <ProjectReference Include="..\MegaCopier.Shell\MegaCopier.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="MegaCopier.Changelog.es.md" />
    <EmbeddedResource Include="..\..\CHANGELOG.en.md" LogicalName="MegaCopier.Changelog.en.md" WithCulture="false" Condition="Exists('..\..\CHANGELOG.en.md')" />
    <EmbeddedResource Include="..\..\docs\capturas\**\*.png" LogicalName="MegaCopier.ChangelogImages.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\tools\Updates\public-key.pem" LogicalName="MegaCopier.UpdatePublicKey.pem" Condition="Exists('..\..\tools\Updates\public-key.pem')" />
  </ItemGroup>

</Project>
