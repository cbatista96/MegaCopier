<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MegaCopier.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MegaCopier.App.ViewModels"
    Title="MegaCopier">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fondo opaco para la opción "Sólido" (con Mica/Acrílico queda oculto) -->
        <Border x:Name="SolidBackground" Grid.RowSpan="3" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed" />

        <!-- Barra de título propia (se integra con el fondo Mica) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/MegaCopier.ico" Width="18" Height="18" />
                <TextBlock Text="MegaCopier" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Cabecera: secciones + acciones -->
        <Grid Grid.Row="1" Padding="20,4,20,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Sections" SelectionChanged="Sections_SelectionChanged">
                <SelectorBarItem x:Name="JobsSection" x:Uid="JobsSection" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="SettingsSection" x:Uid="SettingsSection">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <DropDownButton x:Name="FinishButton" x:Uid="FinishButton" Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="FinishIcon" Glyph="&#xE823;" FontSize="14" />
                    <TextBlock x:Name="FinishText" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="FinishNothing" x:Uid="FinishNothing" GroupName="Finish" IsChecked="True" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishSleep" x:Uid="FinishSleep" GroupName="Finish" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishShutdown" x:Uid="FinishShutdown" GroupName="Finish" Click="Finish_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="NewCopyText" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Uid="CopyFilesItem" Click="CopyFiles_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CopyFolderItem" Click="CopyFolder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Copias -->
        <Grid x:Name="JobsView" Grid.Row="2">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24,0,24,48">
                <FontIcon Glyph="&#xE8C8;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    x:Uid="EmptyDescription"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="JobsScroll" Padding="20,0,20,20">
                <ItemsRepeater ItemsSource="{x:Bind Jobs}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobViewModel">
                            <Border
                                Padding="16,14"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid RowSpacing="6" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Grid.RowSpan="2" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="22"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />

                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DestinationText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button x:Uid="PauseButton" Visibility="{x:Bind CanPause, Mode=OneWay}" Click="{x:Bind Pause}" Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE769;" FontSize="14" />
                                        </Button>
                                        <Button Visibility="{x:Bind CanResume, Mode=OneWay}" Click="{x:Bind Resume}" Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                <TextBlock Text="{x:Bind ResumeLabel, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Uid="StopButton" Visibility="{x:Bind CanStop, Mode=OneWay}" Click="{x:Bind Stop}" Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="OpenFolderButton" Visibility="{x:Bind CanClear, Mode=OneWay}" Click="{x:Bind OpenDestination}" Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="ClearButton" Visibility="{x:Bind CanClear, Mode=OneWay}" Click="{x:Bind Clear}" Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                        <Button x:Uid="DiscardButton" Visibility="{x:Bind CanDiscard, Mode=OneWay}" Click="{x:Bind Discard}" Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     ShowPaused="{x:Bind ShowPaused, Mode=OneWay}"
                                                     ShowError="{x:Bind ShowError, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" MinWidth="32" TextAlignment="Right" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind StateText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Run Text="  " />
                                            <Run Text="{x:Bind CurrentFileText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Expander Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              Visibility="{x:Bind HasFailures, Mode=OneWay}"
                                              Header="{x:Bind FailuresHeader, Mode=OneWay}">
                                        <ScrollViewer MaxHeight="180">
                                            <TextBlock Text="{x:Bind FailuresText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Expander>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Conflicto: el archivo ya existe -->
        <ContentDialog
            x:Name="ConflictDialog"
            x:Uid="ConflictDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MaxWidth="460">
                <TextBlock x:Name="ConflictMessage" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SettingCard}" MinHeight="0">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="ConflictSourceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ConflictSourceSize" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ConflictSourceDate" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SettingCard}" MinHeight="0">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="ConflictExistingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ConflictDestinationSize" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ConflictDestinationDate" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <CheckBox x:Name="ConflictApplyAll" x:Uid="ConflictApplyAll" />
            </StackPanel>
        </ContentDialog>

        <!-- Ajustes -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="2" Visibility="Collapsed" Padding="20,0,20,20">
            <StackPanel Spacing="4" MaxWidth="760" HorizontalAlignment="Stretch">

                <InfoBar x:Name="RestartInfo" x:Uid="RestartInfo" Severity="Informational" IsClosable="False" IsOpen="False" Margin="0,8,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartButton" Click="Restart_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <TextBlock x:Uid="AppearanceHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,8,0,4" />
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="ThemeTitle" />
                            <TextBlock x:Uid="ThemeDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="220" SelectionChanged="ThemeBox_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="ThemeSystem" />
                            <ComboBoxItem x:Uid="ThemeLight" />
                            <ComboBoxItem x:Uid="ThemeDark" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="AccentTitle" />
                            <TextBlock x:Uid="AccentDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="AccentBox" Grid.Column="1" MinWidth="220" SelectionChanged="AccentBox_SelectionChanged" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="BackdropTitle" />
                            <TextBlock x:Uid="BackdropDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="BackdropBox" Grid.Column="1" MinWidth="220" SelectionChanged="BackdropBox_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="BackdropMica" />
                            <ComboBoxItem x:Uid="BackdropMicaAlt" />
                            <ComboBoxItem x:Uid="BackdropAcrylic" />
                            <ComboBoxItem x:Uid="BackdropSolid" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="LanguageTitle" />
                            <TextBlock x:Uid="LanguageDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="220" SelectionChanged="LanguageBox_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="LanguageAuto" Tag="" />
                            <ComboBoxItem Content="Español" Tag="es-ES" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="OnTopTitle" />
                            <TextBlock x:Uid="OnTopDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="OnTopToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnTopToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock x:Uid="CopyHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,4" />
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="VerifyTitle" />
                            <TextBlock x:Uid="VerifyDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="VerifyToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="VerifyToggle_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="ConflictTitle" />
                            <TextBlock x:Uid="ConflictDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ConflictBox" Grid.Column="1" MinWidth="220" SelectionChanged="ConflictBox_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="ConflictAsk" />
                            <ComboBoxItem x:Uid="ConflictReplace" />
                            <ComboBoxItem x:Uid="ConflictSkip" />
                            <ComboBoxItem x:Uid="ConflictNewer" />
                            <ComboBoxItem x:Uid="ConflictKeepBoth" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="SpeedTitle" />
                            <TextBlock x:Uid="SpeedDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="SpeedBox" Grid.Column="1" MinWidth="220" SelectionChanged="SpeedBox_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="SpeedUnlimited" Tag="0" />
                            <ComboBoxItem Content="10 MB/s" Tag="10" />
                            <ComboBoxItem Content="25 MB/s" Tag="25" />
                            <ComboBoxItem Content="50 MB/s" Tag="50" />
                            <ComboBoxItem Content="100 MB/s" Tag="100" />
                            <ComboBoxItem Content="250 MB/s" Tag="250" />
                            <ComboBoxItem Content="500 MB/s" Tag="500" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="AutoResumeTitle" />
                            <TextBlock x:Uid="AutoResumeDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoResumeToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="AutoResumeToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock x:Uid="ExplorerHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,4" />
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="PasteTitle" />
                            <TextBlock x:Uid="PasteDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PasteToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="PasteToggle_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="ShellMenuTitle" />
                            <TextBlock x:Uid="ShellMenuDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShellMenuToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="ShellMenuToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock x:Uid="SystemHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,4" />
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="StartupTitle" />
                            <TextBlock x:Uid="StartupDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="StartupToggle_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="NotifyTitle" />
                            <TextBlock x:Uid="NotifyDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NotifyToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="NotifyToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock x:Name="AboutText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
