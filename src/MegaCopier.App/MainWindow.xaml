<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MegaCopier.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MegaCopier.App.Controls"
    xmlns:vm="using:MegaCopier.App.ViewModels"
    xmlns:views="using:MegaCopier.App.Views"
    Title="MegaCopier">

    <Grid x:Name="Root" Background="{StaticResource McBackgroundBrush}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Textura del tema (madera, brasas...), debajo de todo -->
        <Image x:Name="TextureImage" Grid.RowSpan="3" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- Barra de título propia: icono, nombre y progreso global -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="14,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/MegaCopier.ico" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="MegaCopier" Style="{StaticResource McStrong}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleStatus" Grid.Column="2" Style="{StaticResource McSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Barra de herramientas (vista completa) -->
        <Grid x:Name="Toolbar" Grid.Row="1" Padding="10,0,12,6" ColumnSpacing="4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Uid="Tool_Sidebar" Style="{StaticResource McToolButton}" Click="Sidebar_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE700;" FontSize="15" />
                </Button>
                <DropDownButton x:Uid="Tool_NewCopy" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:McIcon VerticalAlignment="Center" Glyph="&#xE8C8;" FontSize="15" Accent="True" />
                        <TextBlock x:Uid="Tool_NewCopyText" Style="{StaticResource McBody}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="NewMenu" Placement="BottomEdgeAlignedLeft" Opening="NewMenu_Opening">
                            <MenuFlyoutItem x:Uid="CopyFiles" Click="CopyFiles_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="CopyFolder" Click="CopyFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_MoveFiles" Click="MoveFiles_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DE;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="CopyToMenu" x:Uid="Tool_CopyTo"><MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutSubItem.Icon></MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Tool_TestFiles" Click="TestFiles_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_TestFolder" Click="TestFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_HashFolder" Click="HashFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EF;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_HashFiles" Click="HashFiles_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EF;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Tool_SendFiles" Click="SendFiles_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE724;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_SendFolder" Click="SendFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE724;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Decrypt" Click="Decrypt_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE785;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Repair" Click="Repair_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Snapshot" Click="Snapshot_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Restore" Click="Restore_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Compare" Click="Compare_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_MtpImport" Click="MtpImport_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_MtpExport" Click="MtpExport_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Tool_Delete" Click="Delete_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Wipe" Click="Wipe_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Tool_LoadList" Click="LoadList_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Tool_Shelf" Click="Shelf_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <AppBarSeparator Padding="2,0" />
                <Button x:Uid="Tool_PauseAll" Style="{StaticResource McToolButton}" Click="PauseAll_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE769;" FontSize="15" />
                </Button>
                <Button x:Uid="Tool_ResumeAll" Style="{StaticResource McToolButton}" Click="ResumeAll_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE768;" FontSize="15" />
                </Button>
                <Button x:Uid="Tool_ClearDone" Style="{StaticResource McToolButton}" Click="ClearDone_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE74D;" FontSize="15" />
                </Button>
                <AppBarSeparator Padding="2,0" />
                <Button x:Uid="Tool_Timeline" Style="{StaticResource McToolButton}" Click="Timeline_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE121;" FontSize="15" />
                </Button>
                <Button x:Uid="Tool_History" Style="{StaticResource McToolButton}" Click="History_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE81C;" FontSize="15" />
                </Button>
                <Button x:Uid="Tool_Settings" Style="{StaticResource McToolButton}" Click="Settings_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE713;" FontSize="15" />
                </Button>
                <Button x:Uid="Tool_About" Style="{StaticResource McToolButton}" Click="About_Click">
                    <c:McIcon VerticalAlignment="Center" Glyph="&#xE946;" FontSize="15" />
                </Button>
            </StackPanel>
            <DropDownButton x:Name="FinishButton" x:Uid="FinishButton" Grid.Column="2" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:McIcon VerticalAlignment="Center" x:Name="FinishIcon" Glyph="&#xE823;" FontSize="14" Accent="True" />
                    <TextBlock x:Name="FinishText" Style="{StaticResource McBody}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="FinishNothing" x:Uid="FinishNothing" GroupName="Finish" IsChecked="True" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishSleep" x:Uid="FinishSleep" GroupName="Finish" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishHibernate" x:Uid="FinishHibernate" GroupName="Finish" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishShutdown" x:Uid="FinishShutdown" GroupName="Finish" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishSignOut" x:Uid="FinishSignOut" GroupName="Finish" Click="Finish_Click" />
                        <RadioMenuFlyoutItem x:Name="FinishExit" x:Uid="FinishExit" GroupName="Finish" Click="Finish_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Contenido -->
        <Grid x:Name="Body" Grid.Row="2" SizeChanged="Body_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lista de trabajos -->
            <Grid x:Name="Sidebar" Padding="10,0,4,10" RowSpacing="6" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="JobsHeader" Style="{StaticResource McSecondary}" Margin="6,2,0,0" />
                <ListView x:Name="JobList" Grid.Row="1" SelectionMode="Single" SelectionChanged="JobList_SelectionChanged" Padding="0"
                          CanDragItems="True" AllowDrop="True" DragItemsStarting="JobList_DragItemsStarting" DragItemsCompleted="JobList_DragItemsCompleted"
                          DragOver="JobList_DragOver" DragLeave="JobList_DragLeave" Drop="JobList_Drop">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobViewModel">
                            <Grid RowSpacing="4" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="3" Width="36" Height="36" CornerRadius="9" VerticalAlignment="Center" Background="{StaticResource McSurfaceStrongBrush}">
                                    <c:McIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Bind StateBrush, Mode=OneWay}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource McStrong}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TotalPercentText, Mode=OneWay}" Style="{StaticResource McSecondary}" MinWidth="50" TextAlignment="Right" />
                                <c:FlowBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FixedHeight="4" Fill="{StaticResource McTotalBrush}"
                                           Value="{x:Bind TotalFraction, Mode=OneWay}" IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                           IsPaused="{x:Bind IsPaused, Mode=OneWay}" IsError="{x:Bind IsFailed, Mode=OneWay}" IsWarning="{x:Bind HasWarnings, Mode=OneWay}"
                                           IsIndeterminate="{x:Bind BarIndeterminate, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind CardSubtitle, Mode=OneWay}" Style="{StaticResource McSecondary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind CardSubtitle, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Canvas x:Name="JobDropLayer" Grid.Row="1" IsHitTestVisible="False">
                    <Grid x:Name="JobDropLine" Height="10" Visibility="Collapsed">
                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Margin="6,0,0,0" Background="{StaticResource McAccentBrush}" />
                        <Ellipse Width="10" Height="10" HorizontalAlignment="Left" Stroke="{StaticResource McAccentBrush}" StrokeThickness="2.5" Fill="{StaticResource McBackgroundBrush}" />
                    </Grid>
                    <Border x:Name="JobDropBox" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource McAccentBrush}" Visibility="Collapsed" />
                </Canvas>
            </Grid>

            <!-- Detalle del trabajo elegido -->
            <Grid x:Name="Detail" Grid.Column="1" RowSpacing="0" PointerPressed="Detail_PointerPressed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="PanelCard" Margin="10,0,10,0" CornerRadius="10" Background="{StaticResource McSurfaceBrush}" BorderBrush="{StaticResource McBorderBrush}" BorderThickness="1"
                        AllowDrop="True" DragOver="PanelCard_DragOver" DragLeave="PanelCard_DragLeave" Drop="PanelCard_Drop">
                    <views:CopyPanel x:Name="Panel" />
                </Border>

                <!-- Paginador de la ventana compacta cuando hay varias copias -->
                <Grid x:Name="Pager" Grid.Row="1" Margin="10,6,10,0" ColumnSpacing="6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="Pager_Previous" Style="{StaticResource McToolButton}" Click="PagerPrevious_Click"><c:McIcon VerticalAlignment="Center" Glyph="&#xE76B;" FontSize="12" /></Button>
                    <TextBlock x:Name="PagerText" Grid.Column="1" Style="{StaticResource McSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Uid="Pager_Next" Grid.Column="2" Style="{StaticResource McToolButton}" Click="PagerNext_Click"><c:McIcon VerticalAlignment="Center" Glyph="&#xE76C;" FontSize="12" /></Button>
                </Grid>

                <SelectorBar x:Name="Tabs" Grid.Row="2" Margin="6,6,6,0" SelectionChanged="Tabs_SelectionChanged" Visibility="Collapsed">
                    <SelectorBarItem x:Name="FilesItem" x:Uid="Tab_Files"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem x:Name="TargetItem" x:Uid="Tab_Target"><SelectorBarItem.Icon><FontIcon Glyph="&#xEDA2;" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem x:Name="OptionsItem" x:Uid="Tab_Options"><SelectorBarItem.Icon><FontIcon Glyph="&#xE9E9;" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem x:Name="StatusItem" x:Uid="Tab_Status"><SelectorBarItem.Icon><FontIcon Glyph="&#xE9D2;" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem x:Name="LogItem" x:Uid="Tab_Log"><SelectorBarItem.Icon><FontIcon Glyph="&#xE7C3;" /></SelectorBarItem.Icon></SelectorBarItem>
                </SelectorBar>

                <ContentControl x:Name="TabHost" Grid.Row="3" Margin="10,4,10,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection>
                            <ContentThemeTransition HorizontalOffset="24" VerticalOffset="0" />
                        </TransitionCollection>
                    </ContentControl.ContentTransitions>
                </ContentControl>
            </Grid>

            <!-- Sin copias -->
            <ScrollViewer x:Name="EmptyState" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <c:McIcon VerticalAlignment="Center" Glyph="&#xE8C8;" FontSize="44" Accent="True" />
                <TextBlock x:Uid="EmptyTitle" Style="{StaticResource McTitle}" HorizontalAlignment="Center" />
                <TextBlock x:Uid="EmptyDescription" Style="{StaticResource McSecondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Style="{StaticResource McAccentButton}" Click="CopyFiles_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE8A5;" FontSize="14" /><TextBlock x:Uid="CopyFilesText" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource McButton}" Click="CopyFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE8B7;" FontSize="14" /><TextBlock x:Uid="CopyFolderText" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource McButton}" Click="LoadList_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE8E5;" FontSize="14" /><TextBlock x:Uid="Tool_LoadListText" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <HyperlinkButton Click="History_Click"><TextBlock x:Uid="Tool_HistoryText" /></HyperlinkButton>
                    <HyperlinkButton Click="Settings_Click"><TextBlock x:Uid="SettingsSection" /></HyperlinkButton>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- Páginas superpuestas -->
            <views:HistoryPage x:Name="HistoryView" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" />
            <views:SettingsPage x:Name="SettingsView" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" />
            <views:TimelinePage x:Name="TimelineView" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" />
            <views:ComparePage x:Name="CompareView" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" />
        </Grid>

        <!-- Conflicto: el archivo ya existe -->
        <ContentDialog
            x:Name="ConflictDialog"
            x:Uid="ConflictDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MaxWidth="460">
                <TextBlock x:Name="ConflictMessage" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource McCard}">
                        <StackPanel Spacing="2">
                            <Image x:Name="ConflictSourceThumb" Height="80" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:McIcon VerticalAlignment="Center" Glyph="&#xE8A5;" FontSize="13" Accent="True" />
                                <TextBlock x:Name="ConflictSourceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ConflictSourceSize" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ConflictSourceDate" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource McCard}">
                        <StackPanel Spacing="2">
                            <Image x:Name="ConflictDestinationThumb" Height="80" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:McIcon VerticalAlignment="Center" Glyph="&#xE7C3;" FontSize="13" Foreground="{StaticResource McWarningBrush}" />
                                <TextBlock x:Uid="ConflictExistingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ConflictDestinationSize" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ConflictDestinationDate" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <CheckBox x:Name="ConflictApplyAll" x:Uid="ConflictApplyAll" />
                <HyperlinkButton x:Name="ConflictRenameExisting" Click="ConflictRename_Click" Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:McIcon VerticalAlignment="Center" Glyph="&#xE8AC;" FontSize="12" /><TextBlock x:Uid="Conflict_RenameExisting" /></StackPanel>
                </HyperlinkButton>
            </StackPanel>
        </ContentDialog>

        <!-- Destinos de una copia nueva: varios a la vez, favoritos, recientes, mover y programar -->
        <ContentDialog
            x:Name="DestinationsDialog"
            x:Uid="DestinationsDialog"
            PrimaryButtonClick="Destinations_PrimaryClick"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Primary">
            <ContentDialog.Resources>
                <!-- Con cifrado y "más tarde" desplegados no cabe en los 756 px de siempre: usa el alto de la ventana. -->
                <x:Double x:Key="ContentDialogMaxHeight">1400</x:Double>
            </ContentDialog.Resources>
            <StackPanel Spacing="10" MinWidth="440" MaxWidth="520">
                <TextBlock x:Name="DestinationsSummary" TextWrapping="Wrap" />
                <ListView x:Name="DestinationsList" SelectionMode="Multiple" MaxHeight="240" BorderThickness="1" BorderBrush="{StaticResource McBorderBrush}" CornerRadius="6" />
                <TextBlock x:Name="DestinationsNone" x:Uid="Destinations_NoneChosen" TextWrapping="Wrap" Visibility="Collapsed" />
                <Button Click="AddDestination_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><c:McIcon VerticalAlignment="Center" Glyph="&#xE710;" FontSize="12" /><TextBlock x:Uid="Destinations_Add" /></StackPanel>
                </Button>
                <ComboBox x:Name="DestinationsMode" x:Uid="Options_Mode" HorizontalAlignment="Stretch" SelectionChanged="DestinationsMode_Changed">
                    <ComboBoxItem x:Uid="Mode_Copy" />
                    <ComboBoxItem x:Uid="Mode_Mirror" />
                    <ComboBoxItem x:Uid="Mode_Update" />
                    <ComboBoxItem x:Uid="Mode_Folders" />
                    <ComboBoxItem x:Uid="Mode_Organize" />
                </ComboBox>
                <InfoBar x:Name="DestinationsMirrorInfo" x:Uid="Options_MirrorInfo" Severity="Warning" IsClosable="False" IsOpen="False" />
                <CheckBox x:Name="DestinationsMove" x:Uid="Destinations_Move" />
                <CheckBox x:Name="DestinationsDryRun" x:Uid="Destinations_DryRun" />
                <CheckBox x:Name="DestinationsZip" x:Uid="Destinations_Zip" Click="DestinationsEncrypt_Click" />
                <ComboBox x:Name="DestinationsFormat" x:Uid="Destinations_Format" Margin="28,0,0,0" MinWidth="220" Visibility="Collapsed" SelectionChanged="DestinationsEncrypt_Click">
                    <ComboBoxItem x:Uid="Destinations_FormatZip" />
                    <ComboBoxItem x:Uid="Destinations_Format7z" />
                </ComboBox>
                <CheckBox x:Name="DestinationsEncrypt" x:Uid="Destinations_Encrypt" Click="DestinationsEncrypt_Click" />
                <StackPanel x:Name="DestinationsEncryptPanel" Spacing="6" Visibility="Collapsed" Margin="28,0,0,0">
                    <PasswordBox x:Name="DestinationsPassword" x:Uid="Destinations_Password" />
                    <PasswordBox x:Name="DestinationsPassword2" x:Uid="Destinations_Password2" />
                    <TextBlock x:Name="DestinationsPasswordInfo" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox x:Name="DestinationsSchedule" x:Uid="Destinations_Schedule" Click="DestinationsSchedule_Click" />
                <StackPanel x:Name="DestinationsWhen" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <CalendarDatePicker x:Name="DestinationsDate" MinWidth="160" />
                    <TimePicker x:Name="DestinationsTime" ClockIdentifier="24HourClock" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Confirmar el borrado -->
        <ContentDialog
            x:Name="DeleteDialog"
            x:Uid="DeleteDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Close">
            <StackPanel Spacing="10" MaxWidth="460">
                <TextBlock x:Name="DeleteMessage" TextWrapping="Wrap" />
                <InfoBar x:Name="DeleteWarning" x:Uid="Delete_SecureWarning" Severity="Warning" IsClosable="False" IsOpen="False" />
            </StackPanel>
        </ContentDialog>

        <!-- Enviar a otro equipo -->
        <ContentDialog
            x:Name="SendDialog"
            x:Uid="SendDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Primary">
            <StackPanel Spacing="10" MinWidth="400" MaxWidth="480">
                <TextBlock x:Name="SendSummary" TextWrapping="Wrap" />
                <TextBlock x:Uid="Send_Found" Style="{StaticResource McSecondary}" />
                <ListView x:Name="SendPeers" SelectionMode="Single" MaxHeight="160" BorderThickness="1" BorderBrush="{StaticResource McBorderBrush}" CornerRadius="6" SelectionChanged="SendPeers_SelectionChanged" />
                <TextBlock x:Name="SendSearching" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                <TextBox x:Name="SendHostBox" x:Uid="Send_Host" />
                <TextBox x:Name="SendCodeBox" x:Uid="Send_Code" FontFamily="Consolas" CharacterCasing="Upper" />
            </StackPanel>
        </ContentDialog>
        <!-- Móviles y cámaras (MTP): elegir qué copiar del dispositivo, o a qué carpeta suya copiar -->
        <ContentDialog
            x:Name="MtpDialog"
            x:Uid="MtpDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Primary">
            <StackPanel Spacing="10" MinWidth="420" MaxWidth="560">
                <TextBlock x:Name="MtpSummary" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="MtpDeviceBox" HorizontalAlignment="Stretch" SelectionChanged="MtpDevice_SelectionChanged" />
                    <Button x:Uid="Mtp_Refresh" Grid.Column="1" Style="{StaticResource McButton}" MinWidth="0" Width="40" Height="32" Padding="0" Click="MtpRefresh_Click"><c:McIcon Glyph="&#xE72C;" FontSize="14" /></Button>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="MtpUpButton" x:Uid="Mtp_Up" Style="{StaticResource McButton}" MinWidth="0" Width="40" Height="32" Padding="0" Click="MtpUp_Click"><c:McIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                    <TextBlock x:Name="MtpPathText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource McSecondary}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ListView x:Name="MtpList" Height="280" SelectionMode="Multiple"
                          BorderThickness="1" BorderBrush="{StaticResource McBorderBrush}" CornerRadius="6" SelectionChanged="MtpList_SelectionChanged" />
                <TextBlock x:Name="MtpStatus" Style="{StaticResource McSecondary}" TextWrapping="Wrap" />
                <CheckBox x:Name="MtpMoveBox" />
            </StackPanel>
        </ContentDialog>

        <!-- Contraseña (descifrar, o volver a darla tras reiniciar) -->
        <ContentDialog x:Name="PasswordDialog" x:Uid="PasswordDialog" Grid.RowSpan="3" Style="{StaticResource DefaultContentDialogStyle}" DefaultButton="Primary">
            <StackPanel Spacing="8" MaxWidth="420">
                <TextBlock x:Name="PasswordMessage" TextWrapping="Wrap" />
                <PasswordBox x:Name="PasswordBox" x:Uid="Destinations_Password" />
            </StackPanel>
        </ContentDialog>

        <!-- Cuenta atrás antes de apagar, suspender... -->
        <ContentDialog
            x:Name="FinishDialog"
            x:Uid="FinishDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Close">
            <StackPanel Spacing="12" MaxWidth="420">
                <TextBlock x:Name="FinishMessage" TextWrapping="Wrap" />
                <ProgressBar x:Name="FinishProgress" Maximum="100" />
            </StackPanel>
        </ContentDialog>

        <!-- Acerca de -->
        <ContentDialog
            x:Name="AboutDialog"
            x:Uid="AboutDialog"
            Grid.RowSpan="3"
            Style="{StaticResource DefaultContentDialogStyle}"
            DefaultButton="Close">
            <StackPanel Spacing="10" MaxWidth="440">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image Source="ms-appx:///Assets/MegaCopier.ico" Width="40" Height="40" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MegaCopier" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Uid="About_Description" TextWrapping="Wrap" />
                <TextBlock x:Uid="About_Features" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <HyperlinkButton x:Uid="About_DataFolder" Click="DataFolder_Click" Padding="0" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
