  <data name="Theme_silicio-oscuro" xml:space="preserve"><value>다크 실리콘</value></data>
  <data name="Theme_brisa-oscura" xml:space="preserve"><value>다크 브리즈</value></data>
  <data name="Theme_pizarra" xml:space="preserve"><value>슬레이트</value></data>
  <data name="Theme_arcade" xml:space="preserve"><value>아케이드</value></data>
